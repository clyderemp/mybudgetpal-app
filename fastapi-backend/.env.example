# Copy to .env and fill in. Never commit .env.
# Atlas cluster mybudgetpal.nilbypg. One URI, two databases: development and production.
# The database is DERIVED (see app/config.py database_for); locally it is always development.
MONGODB_URI=mongodb+srv://USER:PASSWORD@mybudgetpal.nilbypg.mongodb.net/?retryWrites=true&w=majority&appName=mybudgetpal
# For local dev without Mongo: MONGODB_URI=mongomock://local  (in-memory, refused in production)
# Optional; if set it must equal the routed database or startup refuses. Never set production here.
MONGODB_DB=development
# development only in this file. Production sets APP_ENV=production plus a host marker
# (MYBUDGETPAL_PRODUCTION_HOST=true, or Vercel's VERCEL_ENV=production) in the HOST environment.
APP_ENV=development
# >= 32 bytes. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
ALLOW_REGISTRATION=false
# Optional test DB (tests use mongomock by default)
# MONGODB_URI_TEST=mongodb://localhost:27017
# Rate-limit key. Leave empty (socket peer). Only set to a header that a TRUSTED edge proxy
# overwrites with the real client IP (e.g. X-Real-IP from nginx). Clients can spoof any
# header that reaches the backend untouched.
RATE_LIMIT_CLIENT_IP_HEADER=
# Per-account failed-login lockout
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_MINUTES=15
# Two-tab refresh race grace window (seconds)
REFRESH_REUSE_GRACE_SECONDS=30
